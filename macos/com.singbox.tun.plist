<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Сплит-TUN поверх ядра Happ (socks 127.0.0.1:10808):
     заблокированные в РФ ресурсы (ru-blocked) -> Happ -> узел; всё остальное -> напрямую;
     приватные сети и gosniias.lan -> напрямую; процессы xray/sing-box/Happ -> напрямую (анти-петля) -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.singbox.tun</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/sing-box</string>
        <string>run</string>
        <string>-c</string>
        <string>/usr/local/etc/singbox-tun/config.json</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>5</integer>
    <key>StandardOutPath</key>
    <string>/var/log/singbox-tun.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/singbox-tun.log</string>
</dict>
</plist>
