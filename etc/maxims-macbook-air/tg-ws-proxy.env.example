# env для tg-ws-proxy (~/.config/tg-ws-proxy/env, 0600).
# TG_SECRET в репо НЕ хранится — подставляется на хосте.
TG_HOST=127.0.0.1
TG_PORT=1443
TG_LINK_IP=127.0.0.1
TG_SECRET=<на хосте>
TG_CF_DOMAIN=pclead.co.uk,lovetrue.co.uk
TG_CF_PRIORITY=true
TG_CF_BALANCE=true
TG_FRONTING_DOMAIN=sprinthost.ru
TG_LOG_FILE=/Users/mfilatov/.config/tg-ws-proxy/proxy.log
