# vpn-split — настройки (общие для sing-box TUN, xray и vpn-autoselect).
# Установлен в $SYSCONFDIR/vpn-split.conf (по умолчанию /etc/vpn-split/vpn-split.conf),
# права root 600 — файл содержит ссылку-токен подписки.
# Формат KEY=VALUE; закомментированные ключи используют значение по умолчанию.
# После правки: sudo vpn-autoselect --force  (подписка/узлы)
#               и перезапуск TUN-службы       (DNS/домены/порты), см. README.

# --- Подписка ---------------------------------------------------------------
# URL подписки (base64-список vless:// trojan:// ss:// vmess://).
# install.sh подставит его из переменной VPN_SPLIT_SUB_URL или спросит интерактивно.
SUB_URL=
# Альтернатива подписке: локальный файл со списком URI (тогда SUB_URL пустой)
#NODES_FILE=/etc/vpn-split/nodes.txt
# Как часто перечитывать подписку при живом туннеле, сек (6 часов)
#SUB_TTL=21600

# Фильтр узлов по имени (regex, регистронезависимо). Пример: LTE-узлы с нулевой
# квотой, RU-выход и агрегатор провайдера «Автовыбор».
EXCLUDE_NAMES=LTE|Россия|Автовыбор
#INCLUDE_NAMES=Нидерланды|Германия

# --- Выбор узла -------------------------------------------------------------
# Проверка туннеля через SOCKS (должен отдавать 204) и пробник leastPing —
# лучше запрещённый ресурс, иначе выберется нода, где он не открывается.
#TEST_URL=https://www.youtube.com/generate_204
#PROBE_URL=https://www.youtube.com/generate_204
#PING_SAMPLES=3
#PING_TIMEOUT=2.0
# Сколько лучших узлов класть в конфиг xray; 0 = все (живость в рантайме
# определяет BurstObservatory)
#PING_TOP=0

# --- Локальные входы xray (на SOCKS смотрит sing-box) -----------------------
#SOCKS_PORT=20808
#HTTP_PORT=20809

# --- Сеть -------------------------------------------------------------------
# DNS для прямого трафика (локальный/офисный резолвер или 77.88.8.8)
#DNS_DIRECT=77.88.8.8
# DNS-over-HTTPS через VPN — для заблокированных доменов
#DNS_PROXY=1.1.1.1
# Домены, которые всегда резолвятся через DNS_PROXY (плюс весь ru-blocked
# и домены из domains.proxy)
#DNS_PROXY_DOMAINS=youtube.com,rutracker.org
# Всегда напрямую — и в TUN, и в xray (через запятую; домен со всеми поддоменами).
# Например, внутренняя зона офиса:
#DIRECT_DOMAINS=corp.lan
# Linux: интерфейс для прямого трафика sing-box; auto = маршрут по умолчанию
# на момент старта службы
#DEFAULT_IFACE=auto
# Интерфейс для прямых запросов vpn-autoselect (подписка/пинг); auto = default route
#DIRECT_IFACE=auto
#LOG_LEVEL=info
