<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- vpn-split: sing-box split-TUN; конфиг пересобирается при каждом старте -->
    <key>Label</key>
    <string>@LABEL_PREFIX@.tun</string>
    <key>ProgramArguments</key>
    <array>
        <string>@PYTHON@</string>
        <string>@PREFIX@/libexec/render-config</string>
        <string>--exec</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>5</integer>
    <key>StandardOutPath</key>
    <string>@LOGDIR@/tun.log</string>
    <key>StandardErrorPath</key>
    <string>@LOGDIR@/tun.log</string>
</dict>
</plist>
