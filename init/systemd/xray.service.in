[Unit]
Description=vpn-split: xray (SOCKS/HTTP на 127.0.0.1, узлы из подписки)
Documentation=https://xtls.github.io
After=network-online.target
Wants=network-online.target
# конфиг появляется после первого прогона vpn-autoselect
ConditionPathExists=@STATEDIR@/xray.json

[Service]
Type=simple
@XRAY_SANDBOX@
Environment=XRAY_LOCATION_ASSET=@PREFIX@/share/xray
ExecStart=@PREFIX@/bin/xray run -c @XRAY_CONF_PATH@
Restart=on-failure
RestartSec=5
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
NoNewPrivileges=true
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
