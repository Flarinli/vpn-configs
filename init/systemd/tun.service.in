[Unit]
Description=vpn-split: sing-box split-TUN (ru-blocked -> xray, остальное напрямую)
Documentation=https://sing-box.sagernet.org
After=network-online.target @UNIT_PREFIX@-xray.service
Wants=network-online.target

[Service]
Type=simple
# конфиг собирается при каждом старте: подхватывает текущий интерфейс, настройки и списки
ExecStartPre=@PYTHON@ @PREFIX@/libexec/render-config
ExecStart=@PREFIX@/bin/sing-box run -c @STATEDIR@/singbox.json
Restart=on-failure
RestartSec=5
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
