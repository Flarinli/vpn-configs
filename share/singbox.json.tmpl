{
    "log": {
        "level": "info",
        "timestamp": true
    },
    "dns": {
        "servers": [
            {
                "type": "udp",
                "tag": "dns-direct",
                "server": "@DNS_DIRECT@",
                "detour": "direct"
            },
            {
                "type": "https",
                "tag": "dns-proxy",
                "server": "@DNS_PROXY@",
                "detour": "proxy"
            }
        ],
        "rules": [
            {
                "rule_set": ["geosite-ru-blocked"],
                "action": "route",
                "server": "dns-proxy"
            }
        ],
        "final": "dns-direct"
    },
    "inbounds": [
        {
            "address": [
                "172.19.0.1/30"
            ],
            "auto_route": true,
            "mtu": 1500,
            "route_exclude_address": [
                "213.208.170.209/32",
                "10.0.0.0/8"
            ],
            "stack": "mixed",
            "tag": "tun-in",
            "type": "tun"
        }
    ],
    "outbounds": [
        {
            "domain_resolver": {
                "server": "dns-direct",
                "strategy": "prefer_ipv4"
            },
            "server": "127.0.0.1",
            "server_port": 0,
            "tag": "proxy",
            "type": "socks",
            "udp_fragment": true
        },
        {
            "domain_resolver": {
                "server": "dns-direct",
                "strategy": "prefer_ipv4"
            },
            "tag": "direct",
            "type": "direct"
        }
    ],
    "route": {
        "final": "direct",
        "rules": [
            {
                "outbound": "direct",
                "process_name": [
                    "xray",
                    "sing-box"
                ]
            },
            {
                "action": "sniff"
            },
            {
                "action": "hijack-dns",
                "protocol": "dns"
            },
            {
                "ip_is_private": true,
                "outbound": "direct"
            },
            {
                "domain_suffix": [
                    "gosniias.ru"
                ],
                "outbound": "direct"
            },
            {
                "rule_set": [
                    "geosite-ru-blocked",
                    "geoip-ru-blocked"
                ],
                "outbound": "proxy"
            }
        ],
        "rule_set": [
            {
                "type": "local",
                "tag": "geosite-ru-blocked",
                "format": "binary",
                "path": "@RULES_DIR@/geosite-ru-blocked.srs"
            },
            {
                "type": "local",
                "tag": "geoip-ru-blocked",
                "format": "binary",
                "path": "@RULES_DIR@/geoip-ru-blocked.srs"
            }
        ]
    }
}
