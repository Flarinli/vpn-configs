{
    "log": {
        "level": "info",
        "timestamp": true
    },
    "dns": {
        "servers": [
            {
                "type": "udp",
                "tag": "dns-local",
                "server": "10.24.24.2",
                "detour": "direct"
            },
            {
                "type": "https",
                "tag": "dns-proxy",
                "server": "1.1.1.1",
                "detour": "proxy"
            }
        ],
        "rules": [
            {
                "rule_set": ["geosite-ru-blocked"],
                "action": "route",
                "server": "dns-proxy"
            },
            {
                "domain_suffix": ["youtube.com", "rutracker.org"],
                "action": "route",
                "server": "dns-proxy"
            }
        ],
        "final": "dns-local"
    },
    "inbounds": [
        {
            "address": [
                "172.19.0.1/30"
            ],
            "auto_route": true,
            "mtu": 1500,
            "stack": "mixed",
            "strict_route": true,
            "tag": "tun-in",
            "type": "tun"
        }
    ],
    "outbounds": [
        {
            "domain_resolver": {
                "server": "dns-local",
                "strategy": "prefer_ipv4"
            },
            "server": "127.0.0.1",
            "server_port": 20808,
            "tag": "proxy",
            "type": "socks",
            "udp_fragment": true
        },
        {
            "domain_resolver": {
                "server": "dns-local",
                "strategy": "prefer_ipv4"
            },
            "tag": "direct",
            "type": "direct"
        }
    ],
    "route": {
        "default_interface": "__DEFAULT_IFACE__",
        "default_mark": 36864,
        "final": "direct",
        "rules": [
            {
                "outbound": "direct",
                "process_name": [
                    "xray",
                    "sing-box",
                    "vpn-autoselect"
                ]
            },
            {
                "action": "sniff"
            },
            {
                "action": "hijack-dns",
                "protocol": "dns"
            },
            {
                "ip_is_private": true,
                "outbound": "direct"
            },
            {
                "domain_suffix": [
                    "gosniias.lan"
                ],
                "outbound": "direct"
            },
            {
                "rule_set": [
                    "geosite-ru-blocked",
                    "geoip-ru-blocked"
                ],
                "outbound": "proxy"
            }
        ],
        "rule_set": [
            {
                "type": "local",
                "tag": "geosite-ru-blocked",
                "format": "binary",
                "path": "/usr/local/etc/singbox-tun/rules/geosite-ru-blocked.srs"
            },
            {
                "type": "local",
                "tag": "geoip-ru-blocked",
                "format": "binary",
                "path": "/usr/local/etc/singbox-tun/rules/geoip-ru-blocked.srs"
            }
        ]
    }
}
