# vpn-autoselect — конфигурация
# Файл ставится в /etc/vpn-autoselect.conf (root:root 600 — содержит ссылку-токен!)

# URL подписки (base64-список vless://... / trojan:// / ss:// / vmess://)
SUB_URL=
# Альтернатива подписке: локальный файл со списком URI (тогда SUB_URL пустой)
#NODES_FILE=/etc/vpn-autoselect.nodes

# Системные пути
XRAY_BIN=/usr/local/bin/xray
XRAY_CONF=/usr/local/etc/xray/config.json
SYSTEMD_UNIT=xray.service
STATUS_DIR=/var/lib/vpn-autoselect
CURL_BIN=/usr/bin/curl

# Проверка туннеля (через SOCKS; должен отдавать 204). Лучше — запрещённый ресурс:
TEST_URL=https://www.youtube.com/generate_204
# Пробник burstObservatory (выбор ноды leastPing) — тоже запрещённый ресурс,
# иначе leastPing может выбрать ноду, где google открыт, а youtube — нет
PROBE_URL=https://www.youtube.com/generate_204

# Как часто перечитывать подписку при живом туннеле, сек (6 часов)
SUB_TTL=21600

# Пинг
PING_SAMPLES=3
PING_TIMEOUT=2.0
# Сколько лучших узлов включать в конфиг xray. 0 = ВСЕ узлы подписки
# (TCP-пинг используется только для сортировки; живость в рантайме
# определяет BurstObservatory — недоступные автоматически выбывают).
PING_TOP=0

# Фильтр узлов по имени (regex, регистронезависимо):
# LTE-узлы — триальные с входом в РФ, канал нестабильный; Россия — RU-выход
# (Claude там заблокирован); Автовыбор — агрегатор провайдера.
EXCLUDE_NAMES=LTE|Россия|Автовыбор
#INCLUDE_NAMES=Нидерланды|Германия

# Физический интерфейс для прямых запросов (подписка/пинг) — чтобы работать
# даже когда Happ поднимает TUN. auto = интерфейс default-маршрута.
DIRECT_IFACE=auto

# Добавлять socks://127.0.0.1:10808 (ядро Happ, когда GUI подключён) кандидатом:
# auto (если порт жив) | yes | no
INCLUDE_HAPP=no

# Локальные входы xray (не менять — на них смотрят приложения)
IN_SOCKS_PORT=20808
IN_HTTP_PORT=20809

# Домены, которые всегда идут напрямую (кроме geoip:private, который всегда direct)
DIRECT_DOMAINS=domain:gosniias.lan
